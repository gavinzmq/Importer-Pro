{
  "backend": [
    "npx",
    "ctxslim",
    "--config",
    "scripts/mcp/ctxslim.json"
  ],
  "roots": [
    "C:\\Users\\ASUS\\Desktop\\Importer-Pro"
  ],
  "askPolicy": "elicit",
  "defaultAction": "ask",
  "sandbox": {
    "enabled": true,
    "allowNetwork": true,
    "writeRoots": [],
    "allowUnsandboxed": true
  },
  "audit": {
    "enabled": true,
    "path": "scripts/mcp/logs/gatekeeper-audit.log"
  },
  "logLevel": "info",
  "tools": {
    "profile": "full"
  },
  "denyPaths": [
    "**/.ssh/**",
    "**/.aws/**",
    "**/.claude/.credentials*",
    "**/.config/mcp-gatekeeper/**",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/id_rsa*",
    "**/id_ed25519*",
    "**/.npmrc",
    "**/.netrc",
    "**/.pypirc",
    "**/.docker/config.json",
    "**/.kube/config",
    "**/.gnupg/**",
    "**/Library/Keychains/**"
  ],
  "rules": {
    "deny": [
      "Bash(sudo rm -rf /:*)",
      "Bash(:* --no-preserve-root:*)",
      "Bash(dd if=:*of=/dev/:*)",
      "Bash(spctl --master-disable:*)",
      "Bash(csrutil disable:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(terraform destroy:*)",
      "Bash(npm publish:*)"
    ],
    "allow": [
      "list_servers",
      "slim_stats",
      "search_tools",
      "describe_tools",
      "enable_tools"
    ]
  },
  "maxOutputBytesByTool": {
    "search_tools": 8192,
    "describe_tools": 8192
  },
  "judge": {
    "strategy": "none"
  }
}
