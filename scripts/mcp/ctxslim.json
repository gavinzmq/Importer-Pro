{
  "mcpServers": {
    "dsh-cert-mcp": {
      "command": "node",
      "args": [
        "node_modules/@perrylink/dsh-cert-mcp/src/index.js"
      ]
    },
    "context-mode": {
      "command": "node",
      "args": [
        "node_modules/@mxalbert/context-mode/server.bundle.mjs"
      ]
    },
    "codegraph": {
      "command": "node",
      "args": [
        "node_modules/@colbymchenry/codegraph/npm-shim.js",
        "serve",
        "--mcp"
      ]
    }
  },
  "slim": {
    "mode": "auto",
    "maxTools": 8,
    "pins": [
      "codegraph_explore",
      "ctx_execute",
      "ctx_search"
    ],
    "adaptive": true,
    "disclosure": true,
    "connectTimeout": 45000
  }
}
