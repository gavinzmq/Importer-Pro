{
    "github.copilot.enable": {
        "*": true, // 默认对所有文件开启
        "plaintext": false,
        "markdown": false,
        "*.json": false,
        "*.yaml": false,
        "*.env": false,
        "*.lock": false,
        "**/node_modules/**": false,
        "**/dist/**": false,
        "**/build/**": false,
        "*.test.ts": false, // 可考虑关闭测试文件
        "*.spec.ts": false
    },
    // 2. 使用 "focused" 上下文模式，仅关注当前文件和最近引用的文件
    "copilot.next.contextMode": "focused",
    // 3. 高级优化：禁用自动导入，减少不必要的 Token 消耗
    "github.copilot.advanced.autoImports": false,
    // 将辅助工具模型也指向 DeepSeek Flash，以节省成本
    "chat.utilityModel": "deepseek/deepseek-v4-flash",
    "chat.utilitySmallModel": "deepseek/deepseek-v4-flash",
    // 确保所有主要的对话入口都使用 DeepSeek 模型
    "inlineChat.defaultModel": "DeepSeek V4 Flash (deepseek)",
    "chat.planAgent.defaultModel": "DeepSeek V4 Flash (deepseek)",
    "chat.exploreAgent.defaultModel": "DeepSeek V4 Flash (deepseek)",
    "github.copilot.chat.askAgent.model": "DeepSeek V4 Flash (deepseek)",
    "github.copilot.chat.implementAgent.model": "DeepSeek V4 Flash (deepseek)",
    "github.copilot.chat.exploreAgent.model": "DeepSeek V4 Flash (deepseek)"
    // 4. 高级优化：设置触发延迟 (毫秒)，避免频繁请求
    // "github.copilot.chat.advanced.model": "gpt-4o"
}